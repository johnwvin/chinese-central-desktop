{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chinese Central",
  "version": "0.1.0",
  "identifier": "com.chinesecentral.vanilla",
  "build": {
    "frontendDist": "../go/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chinese Central",
        "url": "http://127.0.0.1:8821/",
        "width": 1450,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../bin/app.ico"
    ]
  }
}
